# Copy this file to .env and replace placeholders with local values.
# Never commit the resulting .env file.

# Django
DJANGO_SECRET_KEY=replace-with-a-local-secret-key
DJANGO_SITE_ID=1
ACCOUNT_EMAIL_VERIFICATION=optional

# Google OAuth credentials are stored in django-allauth SocialApp records.
# Expected callback URL:
# https://your-domain.example/accounts/google/login/callback/

# Cloudflare Workers AI image generation
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_TIMEOUT=90

# Email notifications (console output is the local-development default)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ReelStock Admin <noreply@reelstock.local>
ADMIN_CONTACT_EMAIL=admin@reelstock.local

# Application logging
REELMAKER_LOG_LEVEL=INFO
