# Copy this file to .env and replace placeholders with local values.
# Never commit the resulting .env file.

# Django
DJANGO_SECRET_KEY=replace-with-a-local-secret-key
DJANGO_SITE_ID=1
ACCOUNT_EMAIL_VERIFICATION=optional

# Google OAuth credentials are stored in django-allauth SocialApp records.
# Attach the Google SocialApp to the Site selected by DJANGO_SITE_ID.
# Development callback (authorize this exact URI in Google Cloud):
# http://127.0.0.1:8000/accounts/google/login/callback/

# Cloudflare Workers AI image generation
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_TIMEOUT=90

# Optional reel inference only: scene generation and hosted background removal.
# Without a token, reels use local backgrounds and local background removal.
# These variables do not configure the Cloudflare still-image generator.
HF_API_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_IMAGE_TIMEOUT=60

# Email notifications (console output is the local-development default)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ReelStock Admin <noreply@reelstock.local>
ADMIN_CONTACT_EMAIL=admin@reelstock.local

# Application logging
REELMAKER_LOG_LEVEL=INFO
